# Copy to .env and fill in. .env is gitignored.
ELEVENLABS_API_KEY=
JARVIS_ELEVENLABS_VOICE_ID=
JARVIS_SPEAK_REPLIES=true
JARVIS_OLLAMA_MODEL=qwen2.5:3b
JARVIS_PERSONALITY=playful
JARVIS_PUSH_TO_TALK_HOTKEY=ctrl+space
JARVIS_LOG_LEVEL=INFO
# JARVIS_DATA_DIR=C:\Users\you\AppData\Roaming\Jarvis
# JARVIS_APPS={"spotify": "spotify.exe"}
# JARVIS_FILE_ROOTS=["C:/Users/you/Documents", "D:/Work"]
# JARVIS_GOOGLE_CREDENTIALS=C:\path	o\credentials.json
# Proactive Google alerts (set to false to stop polling)
JARVIS_ALERT_EVENTS=true
JARVIS_ALERT_IMPORTANT_EMAIL=true
JARVIS_ALERT_EVENT_MINUTES=10
JARVIS_ALERT_POLL_MINUTES=5
JARVIS_ALERT_EMAIL_LABEL=IMPORTANT
